{
  "name": "distribute",
  "version": "0.1.0",
  "private": true,
  "description": "The DFY, BYOK MCP Platform",
  "author": "distribute",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shamanic-technologies/distribute.you.git"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:admin": "pnpm --filter @distribute/admin dev",
    "dev:dashboard": "pnpm --filter @distribute/dashboard dev",
    "dev:docs": "pnpm --filter @distribute/docs dev",
    "dev:landing": "pnpm --filter @distribute/landing dev",
    "dev:sales-cold-emails-landing": "pnpm --filter @distribute/sales-cold-emails-landing dev",
    "build": "turbo build",
    "build:app": "pnpm --filter @distribute/app build",
    "build:dashboard": "pnpm --filter @distribute/dashboard build",
    "build:docs": "pnpm --filter @distribute/docs build",
    "build:landing": "pnpm --filter @distribute/landing build",
    "lint": "turbo lint",
    "clean": "turbo clean",
    "generate:readme": "pnpm --filter @distribute/content generate:readme"
  },
  "devDependencies": {
    "turbo": "^2.11.10",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "baseline-browser-mapping@<2.11.0": "^2.11.31",
      "browserslist@<4.28.7": "^4.28.7",
      "dompurify@<3.4.17": "^3.4.17",
      "fflate@<0.4.9": "^0.4.9",
      "js-yaml@>=3.0.0 <3.15.2": "^3.15.2",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "lodash-es@<4.18.0": "^4.18.1",
      "nanoid@<3.3.18": "^3.3.18",
      "picomatch@<2.3.2": "^2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "^4.0.4",
      "postcss-selector-parser@<7.1.6": "^7.1.7",
      "postcss@<8.5.18": "^8.5.18",
      "protobufjs@<7.6.1": "^7.6.1",
      "rollup@>=4.0.0 <4.59.0": "^4.59.0",
      "source-map-js@<1.2.2": "^1.2.2",
      "undici@>=7.0.0 <7.29.1": "^7.29.1",
      "uuid@<11.1.1": "^11.1.1",
      "vite@>=7.0.0 <7.3.7": "^7.3.7",
      "yaml@>=2.0.0 <2.8.3": "^2.8.3"
    }
  }
}
