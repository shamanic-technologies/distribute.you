4b:["$","p","d3ea02942956",{"className":"type-body my-4 font-medium text-foreground/70","children":["On the front lines, BDRs and AEs felt the fragmentation every day. Because Chili Piper logic hadnâ€™t kept up with Cortexâ€™s handoff model, BDRs often had to â€œschedule a meeting, cancel that meeting, build a new meetingâ€ just to get time onto the right AEâ€™s calendar. Routing rules were scattered across Chili Piper and LeanData, so no one could say with confidence that important accounts were getting to the right owner."]}]
4c:["$","p","352939f3e25b",{"className":"type-body my-4 font-medium text-foreground/70","children":["That fragmentation also showed up in the numbers. At the start of a quarter, pipeline looked healthy on paper. By month three, it would collapse to 40% of the original value with no reliable explanation. Auto-created opportunities with generic values, inconsistent ownership, and mismatched fields between Salesforce and Gong made it impossible to trust what was in the CRM. â€œI tried Workato. I tried Celigo. I tried all these random iPaaSâ€™s. Theyâ€™re so rigid, I wasted tons of hours messing around with them,â€ the RevOps leader said. Changing anything felt risky. Reporting was inconsistent. Firefighting tickets and spreadsheet clean-up took priority over strategic work."]}]
4d:["$","figure","acfc32535f4f",{"className":"my-8 flex flex-col gap-8 rounded-[12px] border border-(--section-border) bg-foreground/3 p-6","children":[["$","blockquote",null,{"className":"text-[20px] text-foreground/90 leading-[1.5] tracking-[-0.2px] [word-break:break-word]","style":{"textIndent":"-0.45em"},"children":"â€œWe had around 147 GTM tools and almost no one could explain what half of them did. There was no single place to see how revenue actually flowed.â€"}],["$","figcaption",null,{"className":"flex items-center gap-3","children":[["$","$L49",null,{"alt":"","className":"size-8 shrink-0 rounded-full object-cover","height":32,"src":"https://cdn.sanity.io/images/ewwh9c6j/production/bc99845de9daab430423ad497c8dd0d11a41ef70-800x800.jpg","style":{"boxShadow":"0 0 0 1px rgba(0,0,0,0.04), 0 1px 1px -0.5px rgba(0,0,0,0.06), 0 3px 3px -1.5px rgba(0,0,0,0.06)"},"width":32}],["$","span",null,{"className":"flex min-w-0 flex-col","children":[["$","span",null,{"className":"font-[440] text-[16px] text-foreground leading-[22px] tracking-[-0.32px]","children":"Matt Mcgonegle"}],["$","span",null,{"className":"font-[450] text-[13px] text-foreground/55 leading-[20px]","style":{"fontFeatureSettings":"\"ss01\", \"ss03\""},"children":["Director of GTM Operations",", Cortex"]}]]}]]}]]}]
