ed-md bg-[#f4f4f5] shrink-0"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-lock h-3 w-3 text-[#a1a1aa]" aria-hidden="true"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg></span><span class="min-w-0"><span class="block text-[12px] text-[#71717a]">Anonymous visitor</span><span class="block text-[10.5px] text-[#d4d4d8] tracking-[0.15em]">••••••••••••</span></span></div></div></div><div class="hidden md:flex items-center justify-center" style="opacity:0;transform:translateY(24px)"><span class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-[#e4e4e7] bg-white"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right h-4 w-4 text-[#a1a1aa]" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></span></div><div style="opacity:0;transform:translateY(24px)"><div class="w-full rounded-[22px] border border-[#e4e4e7] bg-white shadow-[0_10px_40px_rgba(9,9,11,0.07)] overflow-hidden"><div class="flex items-center gap-2 border-b border-[#f4f4f5] bg-[#FAFAFA] px-4 py-2.5"><span class="w-1.5 h-1.5 rounded-full bg-[#FE7BCD]"></span><span class="text-[11px] font-medium text-[#09090b]">Website visitors</span><span class="text-[11px] text-[#a1a1aa]">last 7 days</span><span class="ml-auto text-[10px] text-[#a1a1aa]">4 companies</span></div><div class="hidden sm:grid grid-cols-[1.5fr_1.4fr_auto_auto] gap-3 border-b border-[#f4f4f5] px-4 py-2 text-[10px] font-medium uppercase tracking-wider text-[#a1a1aa]"><span>Company</span><span>Pages viewed</span><span class="text-right">Visits</span><span class="text-right">Match</span></div><div class="grid grid-cols-1 sm:grid-cols-[1.5fr_1.4fr_auto_auto] items-center gap-2 sm:gap-3 border-b border-[#f4f4f5] px-4 py-3 last:border-b-0"><div class="flex items-center gap-2.5 min-w-0"><span class="inline-flex items-center justify-center rounded-md font-semibold shrink-0" style="width:28px;height:28px;background:#e0ecf7;color:#3b6ea5;font-size:11px">NL</span><span class="min-w-0"><span class="block truncate text-[12px] font-medium text-[#09090b]">Northwind Logistics</span><span class="block truncate text-[10.5px] text-[#a1a1aa]">northwind.com</span></span></div><span class="truncate text-[11px] text-[#71717a]">/pricing, /integrations</span><span class="text-[11px] text-[#71717a] sm:text-right">9</span><span class="sm:text-right"><span class="inline-flex items-center rounded-full border px-2 py-0.5 text-[10px] font-medium capitalize bg-emerald-50 text-emerald-700 border-emerald-200">very high</span></span></div><div class="grid grid-cols-1 sm:grid-cols-[1.5fr_1.4fr_auto_auto] items-center gap-2 sm:gap-3 border-b border-[#f4f4f5] px-4 py-3 last:border-b-0"><div class="flex items-center gap-2.5 min-w-0"><span class="inline-flex items-center justify-center rounded-md font-semibold shrink-0" style="width:28px;height:28px;background:#e3efe4;color:#3f7a4a;font-size:11px">VH</span><span class="min-w-0"><span class="block truncate text-[12px] font-medium text-[#09090b]">Vellum Health</span><span class="block truncate text-[10.5px] text-[#a1a1aa]">vellumhealth.io</span></span></div><span class="truncate text-[11px] text-[#71717a]">/pricing, /security</span><span class="text-[11px] text-[#71717a] sm:text-right">6</span><span class="sm:text-right"><span class="inline-flex items-center rounded-full border px-2 py-0.5 text-[10px] font-medium capitalize bg-emerald-50/70 text-emerald-700 border-emerald-200/70">high</span></span></div><div class="grid grid-cols-1 sm:grid-cols-[1.5fr_1.4fr_auto_auto] items-center gap-2 sm:gap-3 border-b border-[#f4f4f5] px-4 py-3 last:border-b-0"><div class="flex items-center gap-2.5 min-w-0"><span class="inline-flex items-center justify-center rounded-md font-semibold shrink-0" style="width:28px;height:28px;background:#f6ecd9;color:#9a7636;font-size:11px">KG</span><span class="min-w-0"><span class="block truncate text-[12px] font-medium text-[#09090b]">Kessler Group</span><span class="block truncate text-[10.5px] text-[#a1a1aa]">kesslergroup.co</span></span></div><span class="truncate text-[11px] text-[#71717a]">/demo</span><span class="text-[11px] text-[#71717a] sm:text-right">4</span><span class="sm:text-right"><span class="inline-flex items-center rounded-full border px-2 py-0.5 text-[10px] font-medium capitalize bg-emerald-50/70 text-emerald-700 border-emerald-200/70">high</span></span></div><div class="grid grid-cols-1 sm:grid-cols-[1.5fr_1.4fr_auto_auto] items-center gap-2 sm:gap-3 border-b border-[#f4f4f5] px-4 py-3 last:border-b-0"><div class="flex items-center gap-2.5 min-w-0"><span class="inline-flex items-center justify-center rounded-md font-semibold shrink-0" style="width:28px;height:28px;background:#eae4f7;color:#6b4fa5;font-size:11px">BL</span><span class="min-w-0"><span class="block truncate text-[12px] font-medium text-[#09090b]">Brightpath Labs</span><span class="block truncate text-[10.5px] text-[#a1a1aa]">brightpath.dev</span></span></div><span class="truncate text-[11px] text-[#71717a]">/pricing, /docs, /demo</span><span class="text-[11px] text-[#71717a] sm:text-right">11</span><span class="sm:text-right"><span class="inline-flex items-center rounded-full border px-2 py-0.5 text-[10px] font-medium capitalize bg-amber-50 text-amber-700 border-amber-200">medium</span></span></div></div></div></div></div></section><section class="w-full bg-white py-16 md:py-24"><div class="max-w-[1180px] mx-auto px-4 sm:px-6"><p class="m-0 text-[13px] text-[#71717a]">[02] How a visitor becomes a company</p><h2 class="font-[family-name:var(--font-frank-ruhl-libre)] font-normal text-[clamp(32px,4vw,52px)] leading-[1.05] tracking-[-0.025em] text-[#171717] mb-4 max-w-[720px]" style="opacity:0;transform:translateY(24px)">Six stages, and you pay for exactly one of them.</h2><p class="text-[15px] text-[#52525b] leading-relaxed max-w-[620px] mb-12" style="opacity:0;transform:translateY(24px)">Most raw web traffic is bots and infrastructure. Everything that gets filtered, screened, or thrown out for being a weak guess costs you nothing, so a quiet week is a cheap week rather than a bill for an empty table.</p><div class="flex flex-col gap-4"><div class="flex flex-col gap-1.5 sm:flex-row sm:items-center sm:gap-4" style="opacity:0;transform:translateY(24px)"><div class="flex items-baseline gap-2 sm:w-[190px] sm:shrink-0"><span class="text-[13px] font-medium text-[#09090b]">Visitors scanned</span><span class="text-[11px] tabular-nums text-[#a1a1aa]">1,240</span></div><div class="flex-1"><div class="h-7 w-full rounded-md bg-[#f4f4f5] overflow-hidden"><div class="h-full rounded-md transition-all bg-[#e4e4e7]" style="width:100%"></div></div></div><div class="sm:w-[240px] sm:shrink-0"><span class="text-[11.5px] leading-snug text-[#71717a]">One grouped query against your own PostHog project.</span><span class="ml-1.5 inline-flex items-center rounded-full bg-[#fef0f7] px-1.5 py-0.5 text-[10px] font-medium text-[#9f1853]">free</span></div></div><div class="flex flex-col gap-1.5 sm:flex-row sm:items-center sm:gap-4" style="opacity:0;transform:translateY(24px)"><div class="flex items-baseline gap-2 sm:w-[190px] sm:shrink-0"><span class="text-[13px] font-medium text-[#09090b]">Your own signups</span><span class="text-[11px] tabular-nums text-[#a1a1aa]">−38</span></div><div class="flex-1"><div class="h-7 w-full rounded-md bg-[#f4f4f5] overflow-hidden"><div class="h-full rounded-md transition-all bg-[#e4e4e7]" style="width:88%"></div></div></div><div class="sm:w-[240px] sm:shrink-0"><span class="text-[11.5px] leading-snug text-[#71717a]">Signed-in visitors are already in your funnel. Skipped, never sold back to you.</span><span class="ml-1.5 inline-flex items-center rounded-full bg-[#fef0f7] px-1.5 py-0.5 text-[10px] font-medium text-[#9f1853]">free</span></div></div><div class="flex flex-col gap-1.5 sm:flex-row sm:items-center sm:gap-4" style="opacity:0;transform:translateY(24px)"><div class="flex items-baseline gap-2 sm:w-[190px] sm:shrink-0"><span class="text-[13px] font-medium text-[#09090b]">Bots and noise</span><span class="text-[11px] tabular-nums text-[#a1a1aa]">−812</span></div><div class="flex-1"><div class="h-7 w-full rounded-md bg-[#f4f4f5] overflow-hidden"><div class="h-full rounded-md transition-all bg-[#e4e4e7]" style="width:52%"></div></div></div><div class="sm:w-[240px] sm:shrink-0"><span class="text-[11.5px] leading-snug text-[#71717a]">Crawlers, scripts, private and IPv6 addresses, single-page bounces.</span><span class="ml-1.5 inline-flex items-center rounded-full bg-[#fef0f7] px-1.5 py-0.5 text-[10px] font-medium text-[#9f1853]">free</span></div></div><div class="flex flex-col gap-1.5 sm:flex-row sm:items-center sm:gap-4" style="opacity:0;transform:translateY(24px)"><div class="flex items-baseline gap-2 sm:w-[190px] sm:shrink-0"><span class="text-[13px] font-medium text-[#09090b]">Datacenter and VPN</span><span class="text-[11px] tabular-nums text-[#a1a1aa]">−141</span></div><div class="flex-1"><div class="h-7 w-full rounded-md bg-[#f4f4f5] overflow-hidden"><div class="h-full rounded-md transition-all bg-[#e4e4e7]" style="width:34%"></div></div></div><div class="sm:w-[240px] sm:shrink-0"><span class="text-[11.5px] leading-snug text-[#71717a]">Where IP-to-company gets its worst answers. Screened out before resolving.</span><span class="ml-1.5 inline-flex items-center rounded-full bg-[#fef0f7] px-1.5 py-0.5 text-[10px] font-medium text-[#9f1853]">free</span></div></div><div class="flex flex-col gap-1.5 sm:flex-row sm:items-center sm:gap-4" style="opacity:0;transform:translateY(24px)"><div class="flex items-baseline gap-2 sm:w-[190px] sm:shrink-0"><span class="text-[13px] font-medium text-[#09090b]">Low confidence</span><span class="text-[11px] tabular-nums text-[#a1a1aa]">−96</span></div><div class="flex-1"><div class="h-7 w-full rounded-md bg-[#f4f4f5] overflow-hidden"><div class="h-full rounded-md transition-all bg-[#e4e4e7]" style="width:18%"></div></div></div><div class="sm:w-[240px] sm:shrink-0"><span class="text-[11.5px] leading-snug text-[#71717a]">A guess we&#x27;re not confident in is worse than no row. Dropped, not shipped.</span><span class="ml-1.5 inline-flex items-center rounded-full bg-[#fef0f7] px-1.5 py-0.5 text-[10px] font-medium text-[#9f1853]">free</span></div></div><div class="flex flex-col gap-1.5 sm:flex-row sm:items-center sm:gap-4" style="opacity:0;transform:translateY(24px)"><div class="flex items-baseline gap-2 sm:w-[190px] sm:shrink-0"><span class="text-[13px] font-medium text-[#09090b]">Companies delivered</span><span class="text-[11px] tabular-nums text-[#a1a1aa]">47</span></div><div class="flex-1"><div class="h-7 w-full rounded-md bg-[#f4f4f5] overflow-hidden"><div class="h-full rounded-md transition-all bg-[#FE7BCD]" style="width:12%"></div></div></div><div class="sm:w-[240px] sm:shrink-0"><span class="text-[11.5px] leading-snug text-[#71717a]">The only line you pay for. $0.11 each.</span></div></div></div></div></section><section id="intent" class="w-full bg-[#fafafa] border-y border-[#e4e4e7] py-16 md:py-24"><div class="max-w-[1180px] mx-auto px-4 sm:px-6"><p class="m-0 text-[13px] text-[#71717a]">[03] Intent, before you spend</p><h2 class="font-[family-name:var(--font-frank-ruhl-libre)] font-normal text-[clamp(32px,4vw,52px)] leading-[1.05] tracking-[-0.025em] text-[#171717] mb-4 max-w-[720px]" style="opacity:0;transform:translateY(24px)">A pricing-page visitor is worth finding. A blog bounce usually isn&#x27;t.</h2><p class="text-[15px] text-[#52525b] leading-relaxed max-w-[620px] mb-10" style="opacity:0;transform:translateY(24px)">Point it at the pages that mean something - pricing, demo, security, a specific product page - and set a minimum number of pageviews. The filter runs before anything is resolved, so narrowing your intent narrows your bill too.</p><div class="grid sm:grid-cols-3 gap-4"><div class="rounded-[20px] border border-[#e4e4e7] bg-white p-5" style="opacity:0;transform:translateY(24px)"><p class="text-[13px] font-medium text-[#09090b] mb-2">Everyone who read pricing twice</p><p class="text-[11.5px] text-[#a1a1aa] font-mono">/pricing, /plans · 2+ views</p></div><div class="rounded-[20px] border border-[#e4e4e7] bg-white p-5" style="opacity:0;transform:translateY(24px)"><p class="text-[13px] font-medium text-[#09090b] mb-2">Anyone who hit the demo page</p><p class="text-[11.5px] text-[#a1a1aa] font-mono">/demo · last 14 days</p></div><div class="rounded-[20px] border border-[#e4e4e7] bg-white p-5" style="opacity:0;transform:translateY(24px)"><p class="text-[13px] font-medium text-[#09090b] mb-2">Security reviewers</p><p class="text-[11.5px] text-[#a1a1aa] font-mono">/security, /trust · 1+ view</p></div></div></div></section><section class="w-full bg-white py-16 md:py-24"><div class="max-w-[1180px] mx-auto px-4 sm:px-6"><p class="m-0 text-[13px] text-[#71717a]">[04] What it will and won&#x27;t tell you</p><h2 class="font-[family-name:var(--font-frank-ruhl-libre)] font-normal text-[clamp(32px,4vw,52px)] leading-[1.05] tracking-[-0.025em] text-[#171717] mb-4 max-w-[760px]" style="opacity:0;transform:translateY(24px)">We could name a person for every visitor. It would be wrong, so we don&#x27;t.</h2><p class="text-[15px] text-[#52525b] leading-relaxed max-w-[660px] mb-10" style="opacity:0;transform:translateY(24px)">We tested person-level visitor identification against known answers. Every vendor returned a confident name, and the names were wrong - shared office networks, VPN exits, and carrier NAT all look like one specific human to a resolver. So Origami stops at the company, where the claim holds up, and then finds the decision-maker there properly.</p><div class="grid md:grid-cols-2 gap-6 lg:gap-10"><div class="rounded-[20px] border border-[#e4e4e7] bg-[#FAFAFA] p-6" style="opacity:0;transform:translateY(24px)"><p class="text-[13px] font-medium text-[#09090b] mb-4">What you get</p><ul class="space-y-3"><li class="flex items-start gap-2.5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check mt-[3px] h-4 w-4 shrink-0 text-[#d64a9e]" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg><span class="text-[14px] leading-relaxed text-[#52525b]">The <strong class="font-medium text-[#52525b]">company</strong> behind the visit, with the pages they read, how often, and when they were last on.</span></li><li class="flex items-start gap-2.5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check mt-[3px] h-4 w-4 shrink-0 text-[#d64a9e]" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg><span class="text-[14px] leading-relaxed text-[#52525b]">Only matches we&#x27;re confident in. Weak guesses are dropped rather than shipped and charged for.</span></li><li class="flex items-start gap-2.5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check mt-[3px] h-4 w-4 shrink-0 text-[#d64a9e]" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg><span class="text-[14px] leading-relaxed text-[#52525b]">Strangers only. Visitors who were signed in are your own signups, and your own team browsing from the office is filtered out too.</span></li></ul></div><div class="rounded-[20px] border border-[#e4e4e7] bg-[#FAFAFA] p-6" style="opacity:0;transform:translateY(24px)"><p class="text-[13px] font-medium text-[#09090b] mb-4">What we won&#x27;t claim</p><ul class="space-y-3"><li class="flex items-start gap-2.5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x mt-[3px] h-4 w-4 shrink-0 text-[#a1a1aa]" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg><span class="text-[14px] leading-relaxed text-[#52525b]">The individual person who visited. Nobody can do this reliably, whatever the category&#x27;s marketing says.</span></li><li class="flex items-start gap-2.5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x mt-[3px] h-4 w-4 shrink-0 text-[#a1a1aa]" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg><span class="text-[14px] leading-relaxed text-[#52525b]">Every visitor. About a quarter of genuine human traffic resolves to a named company, and coverage is best on business and office networks.</span></li><li class="flex items-start gap-2.5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x mt-[3px] h-4 w-4 shrink-0 text-[#a1a1aa]" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg><span class="text-[14px] leading-relaxed text-[#52525b]">Anyone else&#x27;s traffic. This reads your analytics and only yours.</span></li></ul></div></div><p class="mt-8 text-[12.5px] leading-relaxed text-[#a1a1aa] max-w-[660px]" style="opacity:0;transform:translateY(24px)">Visitor addresses are never stored or shown. They exist only inside the resolution step, and what we remember afterwards is the company, not the address it came from.</p></div></section><section class="w-full bg-[#fafafa] border-y border-[#e4e4e7] py-16 md:py-24"><div class="max-w-[1180px] mx-auto px-4 sm:px-6"><p class="m-0 text-[13px] text-[#71717a]">[05] Setup is one paste, not a deploy</p><h2 class="font-[family-name:var(--font-frank-ruhl-libre)] font-normal text-[clamp(32px,4vw,52px)] leading-[1.05] tracking-[-0.025em] text-[#171717] mb-4 max-w-[720px]" style="opacity:0;transform:translateY(24px)">Works through PostHog. No pixel, no script, no engineer.</h2><p class="text-[15px] text-[#52525b] leading-relaxed max-w-[640px] mb-10" style="opacity:0;transform:translateY(24px)">PostHog is the one mainstream analytics tool that both keeps the raw visitor address and lets you authorize someone to read it. If you&#x27;re on it, this takes about a minute. If you&#x27;re on GA4, Plausible, Fathom, or Vercel, there is no address stored to resolve - we&#x27;d rather say that than sell you a table of nothing.</p><div class="grid md:grid-cols-3 gap-5"><div class="rounded-[20px] border border-[#e4e4e7] bg-white p-6" style="opacity:0;transform:translateY(24px)"><p class="text-[13.5px] font-medium text-[#09090b] mb-1.5">Paste a read-only key</p><p class="text-[14px] leading-relaxed text-[#52525b]">Two scopes, both read-only: one to find the project, one to run the query. Nothing in Origami can write to your analytics.</p></div><div class="rounded-[20px] border border-[#e4e4e7] bg-white p-6" style="opacity:0;transform:translateY(24px)"><p class="text-[13.5px] font-medium text-[#09090b] mb-1.5">Nothing touches your site</p><p class="text-[14px] leading-relaxed text-[#52525b]">No pixel, no script tag, no deploy. We read the traffic data you already collect, and you can revoke the key in PostHog at any time.</p></div><div class="rounded-[20px] border border-[#e4e4e7] bg-white p-6" style="opacity:0;transform:translateY(24px)"><p class="text-[13.5px] font-medium text-[#09090b] mb-1.5">We check it actually works</p><p class="text-[14px] leading-relaxed text-[#52525b]">On connect we run a traffic probe and tell you the truth: live, no traffic yet, IP capture switched off, or a proxy collapsing every visitor onto one address.</p></div></div></div></section><section id="follow-through" class="w-full bg-white pt-16 pb-20 md:pt-20 md:pb-28"><div class="max-w-[1180px] mx-auto px-4 sm:px-6"><p class="m-0 text-[13px] text-[#71717a]">[06] A company name isn&#x27;t a pipeline</p><h2 class="font-[family-name:var(--font-frank-ruhl-libre)] font-normal text-[clamp(32px,4vw,52px)] leading-[1.05] tracking-[-0.025em] text-[#171717] mb-4 max-w-[720px]" style="opacity:0;transform:translateY(24px)">The list is the start. Origami does the rest in the same chat.</h2><p class="text-[15px] text-[#52525b] leading-relaxed max-w-[620px] mb-12" style="opacity:0;transform:translateY(24px)">Every other tool in this category hands you a list of logos and calls it a product. A company row has nobody to email. Here it&#x27;s one continuous build.</p><div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5"><div class="flex flex-col" style="opacity:0;transform:translateY(24px)"><span class="font-mono text-[13px] text-[#71717a] mb-3">01</span><p class="text-[14px] font-medium text-[#09090b] mb-2 leading-snug">Find the right person there</p><p class="text-[14px] leading-relaxed text-[#52525b]">A company row is a signal, not a contact. Origami runs a people search at each domain, filtered to the titles you actually sell to.</p></div><div class="flex flex-col" style="opacity:0;transform:translateY(24px)"><span class="font-mono text-[13px] text-[#71717a] mb-3">02</span><p class="text-[14px] font-medium text-[#09090b] mb-2 leading-snug">Get their contact details</p><p class="text-[14px] leading-relaxed text-[#52525b]">Verified work email, and a phone number if you work the phone. You are only charged when one is found.</p></div><div class="flex flex-col" style="opacity:0;transform:translateY(24px)"><span class="font-mono text-[13px] text-[#71717a] mb-3">03</span><p class="text-[14px] font-medium text-[#09090b] mb-2 leading-snug">Write from what they read</p><p class="text-[14px] leading-relaxed text-[#52525b]">The pages a company viewed are the best personalization material in outbound. An AI column reads them and drafts why they were probably looking.</p></div><div class="flex flex-col" style="opacity:0;transform:translateY(24px)"><span class="font-mono text-[13px] text-[#71717a] mb-3">04</span><p class="text-[14px] font-medium text-[#09090b] mb-2 leading-snug">Keep it topped up</p><p class="text-[14px] leading-relaxed text-[#52525b]">Visitors arrive continuously and every run picks up where the last one stopped, so the list refills itself daily instead of going stale.</p></div></div><div class="mt-12 rounded-[20px] border border-[#fecce8] bg-white p-6 sm:p-8" style="opacity:0;transform:translateY(24px)"><p class="text-[15px] font-medium text-[#09090b] mb-2">A one-off scan is the demo. The daily drip is the product.</p><p class="text-[14px] leading-relaxed text-[#52525b] max-w-[640px]">Each run resumes exactly where the last one stopped, so nobody is looked up - or paid for - twice. Leave it running and the companies reading your site this week are in your list by the time you sit down.</p></div></div></section></main><section class="w-full px-5 py-[clamp(56px,9vw,104px)]"><div class="mx-auto grid max-w-[1240px] grid-cols-[repeat(auto-fit,minmax(min(100%,400px),1fr))] items-center gap-8 rounded-[28px] border border-[#fcc6e3] bg-[#fef0f7] p-[clamp(32px,6vw,80px)]"><div class="flex flex-col gap-4"><h2 class="font-[family-name:var(--font-frank-ruhl-libre)] font-normal m-0 text-[clamp(34px,4.4vw,60px)] leading-[1.02] tracking-[-0.03em] text-[#171717]">Find your next perfect customers.</h2><p class="m-0 max-w-[520px] text-[17px] leading-relaxed text-[#52525b]">Join teams who are already using AI to build pipeline faster. Start your free trial today.</p></div><div clas