ww.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-menu" aria-hidden="true"><path d="M4 5h16"></path><path d="M4 12h16"></path><path d="M4 19h16"></path></svg></button></div></nav></header><main class="flex flex-col min-h-screen bg-white"><section class="w-full bg-[#FAFAFA] pt-12 pb-16 md:pt-16 md:pb-20"><div class="max-w-[1000px] mx-auto px-4 sm:px-6"><p class="text-[11px] sm:text-xs font-medium tracking-[0.2em] uppercase text-[#09090b]/40 mb-6" style="opacity:0">Product / Real-Time Data</p><h1 class="text-3xl sm:text-4xl md:text-5xl font-medium text-[#09090b] leading-[1.1] tracking-tight mb-6 max-w-[700px]" style="opacity:0;transform:translateY(20px)">Live search.<br/><span class="text-[#a1a1aa]">Not a 6-month-old database.</span></h1><p class="text-sm sm:text-[15px] text-[#71717a] leading-relaxed max-w-[520px] mb-8" style="opacity:0;transform:translateY(16px)">Apollo, ZoomInfo, and Clay all query a database they maintain. That database was last updated at some point, and that point wasn&#x27;t today. Origami searches the actual web, in real time, every time you run a search.</p><div style="opacity:0;transform:translateY(12px)"><div class="flex items-center gap-3"><a href="/sign-up" class="inline-flex items-center gap-2 px-6 py-3 text-[14px] font-medium text-white bg-[#09090b] hover:bg-[#09090b]/80 transition-all duration-150 rounded-full group">Start Free<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right w-4 h-4 transition-transform duration-200 group-hover:translate-x-0.5" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a><a href="https://calendly.com/d/cxyb-p4r-qwg" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-6 py-3 text-[14px] font-medium text-[#09090b] bg-white border border-[#e4e4e7] hover:bg-[#f4f4f5] transition-all duration-150 rounded-full">Book a Demo</a></div></div></div></section><section class="w-full bg-[#FAFAFA] border-y border-[#e4e4e7] py-16 md:py-24"><div class="max-w-[1100px] mx-auto px-4 sm:px-6"><p class="text-[11px] sm:text-xs font-medium tracking-[0.2em] uppercase text-[#09090b]/40 mb-10 md:mb-14" style="opacity:0">[01] How it works</p><div class="relative"><div class="absolute left-[19px] top-0 bottom-0 w-px bg-[#e4e4e7] hidden md:block"></div><div class="space-y-0 divide-y divide-[#e4e4e7]"><div class="flex flex-col md:flex-row gap-6 md:gap-12 py-8 md:py-10" style="opacity:0;transform:translateX(-16px)"><div class="flex-shrink-0 flex items-start gap-4 md:w-[200px]"><div class="w-10 h-10 border-2 border-[#FE7BCD] bg-white flex items-center justify-center flex-shrink-0 relative z-10"><span class="text-[13px] font-semibold text-[#FE7BCD]">01</span></div><div><p class="text-[13px] font-medium text-[#09090b]">You describe who you&#x27;re looking for</p></div></div><div class="md:flex-1"><p class="text-sm text-[#71717a] leading-relaxed mb-3">In plain English. No Boolean logic, no filter dropdowns, no field mapping. Just describe your target the way you&#x27;d describe them to a researcher.</p><div class="border border-[#e4e4e7] bg-white px-4 py-3"><p class="text-[12px] text-[#a1a1aa] italic">&quot;Dental practices in Florida with 2-5 locations that have been open for at least 3 years&quot;</p></div></div></div><div class="flex flex-col md:flex-row gap-6 md:gap-12 py-8 md:py-10" style="opacity:0;transform:translateX(-16px)"><div class="flex-shrink-0 flex items-start gap-4 md:w-[200px]"><div class="w-10 h-10 border-2 border-[#FE7BCD] bg-white flex items-center justify-center flex-shrink-0 relative z-10"><span class="text-[13px] font-semibold text-[#FE7BCD]">02</span></div><div><p class="text-[13px] font-medium text-[#09090b]">Origami identifies